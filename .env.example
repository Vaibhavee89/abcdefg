# Copy the relevant lines into frontend/.env (for VITE_ vars) and/or your shell
# or deployment environment (for the backend vars). Nothing here is required
# for local development — every value below has a working default.

# --- frontend (frontend/.env) ---
# Base URL the frontend calls for the API. Leave unset for local dev: Vite's
# dev server proxies /api to http://127.0.0.1:8000 (see frontend/vite.config.js).
# Set this to the deployed backend URL when deploying the frontend separately.
VITE_API_URL=

# --- backend ---
# Overrides where the backend looks for actuals_raw.parquet / forecasts_raw.parquet.
# Defaults to backend/data (if present, e.g. in the Vercel deployment) or else
# the repo-root data/ directory (local/Docker runs). Only set this if you need
# to point at a different data snapshot.
DATA_DIR=

# Port uvicorn binds to inside the Docker container. Defaults to 8000.
PORT=8000
